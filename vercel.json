{
  "buildCommand": "cd campus-bites && npm install && npm run build",
  "outputDirectory": "campus-bites/dist",
  "installCommand": "cd campus-bites && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/campus-bites/dist/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "campus-bites/server/**",
        "campus-bites/server/.env"
      ]
    }
  }
}
